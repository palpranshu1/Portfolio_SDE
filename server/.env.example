# Server Port & Environment
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/pranshu_portfolio

# JWT Secret (minimum 32 random characters for strong security)
JWT_SECRET=replace_with_a_long_random_secret_key_at_least_32_chars_long

# Initial Administrator Credentials (Used by seed script or first run)
ADMIN_EMAIL=palpranshu913@gmail.com
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongPassword123!

# Gmail SMTP Credentials for Email Notifications & Replies
# Generate an App Password in Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER=palpranshu913@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password
